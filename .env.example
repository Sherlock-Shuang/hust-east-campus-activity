# Server-only settings. Never use VITE_ names for secrets.
# Production: configure on your host; reuse the existing Turso database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
ADMIN_PASSWORD=
TASAY_LLM_API_KEY=
TASAY_LLM_BASE_URL=
TASAY_LLM_MODEL=
# Optional secondary model:
TASAY_FAST_LLM_API_KEY=
TASAY_FAST_LLM_BASE_URL=
TASAY_FAST_LLM_MODEL=
# Portable production host only (npm run start:host):
# PUBLIC_ORIGIN=https://www.the-most-interesting.online
# Render initially uses RENDER_EXTERNAL_URL automatically. Set PUBLIC_ORIGIN
# when switching to the verified custom domain; no path or trailing slash.
# Local Node only: HOST=0.0.0.0 for LAN access; default 127.0.0.1:5178.
# HOST=127.0.0.1
# PORT=5178
