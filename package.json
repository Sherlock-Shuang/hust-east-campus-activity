{
  "name": "hust-east-campus-activity",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "build": "vite build",
    "build:works": "node integration/library/build.mjs && node integration/tasay/build.mjs",
    "build:activity": "npm run build:works && npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs deploy-assets/prepare-local.test.mjs",
    "start": "node server/index.mjs",
    "build:vercel": "vite build && node deploy-assets/materialize.mjs --assets asset-source --output dist",
    "db:migrate": "node serverless/migrate.mjs",
    "prestart": "node deploy-assets/prepare-local.mjs",
    "predev": "node deploy-assets/prepare-local.mjs"
  },
  "dependencies": {
    "polygon-clipping": "^0.15.7",
    "three": "0.180.0",
    "@libsql/client": "0.18.0"
  },
  "devDependencies": {
    "vite": "^7.3.7"
  },
  "engines": {
    "node": "24.x"
  }
}
